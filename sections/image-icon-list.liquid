{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="icon-marquee{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  id="IconMarquee-{{ section.id }}"
  style="--padding-block-start: {{ section.settings.padding_top }}px; --padding-block-end: {{ section.settings.padding_bottom }}px;"
>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
    "
  >
    <div class="icon-marquee__track-wrapper">
      <div 
        class="icon-marquee__track" 
        style="animation-duration: {{ section.settings.speed }}s; animation-direction: {{ section.settings.direction }};"
      >
        <!-- Original Group -->
        <div class="icon-marquee__group" style="gap: {{ section.settings.gap }}px; padding-right: {{ section.settings.gap }}px;">
          {% for block in section.blocks %}
            <div class="icon-marquee__item" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="icon-marquee__link">
              {% endif %}

              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 300 }}" 
                  alt="{{ block.settings.image.alt | escape }}" 
                  class="icon-marquee__img" 
                  style="width: {{ section.settings.icon_width }}px; height: auto;" 
                  loading="lazy" 
                />
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'icon-marquee__placeholder' }}
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <!-- Duplicated Group for Seamless Loop -->
        <div class="icon-marquee__group" aria-hidden="true" style="gap: {{ section.settings.gap }}px; padding-right: {{ section.settings.gap }}px;">
          {% for block in section.blocks %}
            <div class="icon-marquee__item">
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="icon-marquee__link">
              {% endif %}

              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 300 }}" 
                  alt="{{ block.settings.image.alt | escape }}" 
                  class="icon-marquee__img" 
                  style="width: {{ section.settings.icon_width }}px; height: auto;" 
                  loading="lazy" 
                />
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'icon-marquee__placeholder' }}
              {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .icon-marquee {
    width: 100%;
    padding-top: var(--padding-block-start);
    padding-bottom: var(--padding-block-end);
    overflow: hidden;
    user-select: none;
  }

  .icon-marquee__track-wrapper {
    overflow: hidden;
    width: 100%;
    position: relative;
    display: flex;
  }

  .icon-marquee__track {
    display: flex;
    width: max-content;
    animation: iconMarqueeScroll linear infinite;
  }

  .icon-marquee__track:hover {
    animation-play-state: paused;
  }

  .icon-marquee__group {
    display: flex;
    align-items: center;
    justify-content: space-around;
    min-width: 100%;
    flex-shrink: 0;
  }

  .icon-marquee__item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .icon-marquee__item:hover {
    transform: scale(1.08);
  }

  .icon-marquee__link {
    display: block;
    line-height: 0;
  }

  .icon-marquee__img {
    display: block;
    object-fit: contain;
  }

  .icon-marquee__placeholder {
    width: 48px;
    height: 48px;
    fill: #dfdfdf;
    opacity: 0.5;
  }

  @keyframes iconMarqueeScroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>

{% schema %}
{
  "name": "Image Icon List",
  "tag": "section",
  "class": "image-icon-list-section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF8F6"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon Width",
      "min": 20,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between Icons",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Marquee Speed (Seconds)",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 20
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "normal",
          "label": "Right to Left"
        },
        {
          "value": "reverse",
          "label": "Left to Right"
        }
      ],
      "default": "normal"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "icon_block",
      "name": "Icon Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Icon Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Icon List",
      "blocks": [
        { "type": "icon_block" },
        { "type": "icon_block" },
        { "type": "icon_block" },
        { "type": "icon_block" },
        { "type": "icon_block" },
        { "type": "icon_block" }
      ]
    }
  ]
}
{% endschema %}
