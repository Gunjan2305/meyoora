{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="collection-tabs section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  id="CollectionTabs-{{ section.id }}"
>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <!-- Tab navigation buttons -->
    <div class="collection-tabs__header">
      {% for block in section.blocks %}
        {% if block.type == 'tab' %}
          <button
            type="button"
            class="collection-tabs__tab-btn{% if forloop.first %} active{% endif %}"
            data-tab="tab-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title | default: 'Tab Title' }}
          </button>
        {% endif %}
      {% endfor %}
    </div>

    <div class="collection-tabs__body">
      <!-- Left side: dynamic title and SVG curve arrow -->
      <div class="collection-tabs__left">
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            <h2 class="collection-tabs__title collection-tabs__title--tab-{{ block.id }}{% if forloop.first %} active{% endif %}">
              {{ block.settings.title | default: 'Tab Title' }}
            </h2>
          {% endif %}
        {% endfor %}
        <div class="collection-tabs__arrow">
          <svg width="50" height="50" viewBox="0 0 50 50" fill="none" style="stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;">
            <path d="M10 10 C 10 30, 25 35, 40 35" />
            <path d="M32 27 L 42 35 L 32 43" />
          </svg>
        </div>
      </div>

      <!-- Right side: Carousels -->
      <div class="collection-tabs__right">
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            <div class="collection-tabs__content{% if forloop.first %} active{% endif %}" id="tab-{{ block.id }}-content">
              {%- liquid
                # Loop and build slides list
              -%}
              {% capture tab_slides %}
                {% for i in (1..8) %}
                  {% capture col_key %}collection_{{ i }}{% endcapture %}
                  {% capture img_key %}image_{{ i }}{% endcapture %}
                  {% capture title_key %}title_{{ i }}{% endcapture %}
                  {% capture link_key %}link_{{ i }}{% endcapture %}

                  {% assign collection = block.settings[col_key] %}
                  {% assign custom_img = block.settings[img_key] %}
                  {% assign custom_title = block.settings[title_key] %}
                  {% assign custom_link = block.settings[link_key] %}

                  {% assign card_title = custom_title | default: collection.title %}
                  {% assign card_link = custom_link | default: collection.url %}
                  {% assign card_image = custom_img | default: collection.featured_image %}

                  {% if card_title != blank or card_link != blank or card_image != blank %}
                    <div class="resource-list__item">
                      <div class="collection-tabs__card">
                        <a {% if card_link != blank %}href="{{ card_link }}"{% else %}role="link" aria-disabled="true"{% endif %} class="collection-tabs__card-link">
                          <div class="collection-tabs__card-image-wrapper">
                            {% if card_image != blank %}
                              {{ card_image | image_url: width: 400 | image_tag: class: 'collection-tabs__card-image', loading: 'lazy' }}
                            {% else %}
                              {{ 'collection-1' | placeholder_svg_tag: 'collection-tabs__card-image placeholder-svg' }}
                            {% endif %}
                          </div>
                          <h3 class="collection-tabs__card-title">{{ card_title }}</h3>
                        </a>
                      </div>
                    </div>
                    <!--@list/split-->
                  {% endif %}
                {% endfor %}
              {% endcapture %}

              {% assign tab_slides_arr = tab_slides | strip | split: '<!--@list/split-->' %}
              
              {%- capture clean_slides_captured -%}
                {%- for slide in tab_slides_arr -%}
                  {%- assign slide_stripped = slide | strip -%}
                  {%- if slide_stripped != blank -%}
                    {{- slide_stripped -}}
                    {%- unless forloop.last -%}<!--@clean_split-->{%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              
              {%- assign clean_slides_arr = clean_slides_captured | strip | split: '<!--@clean_split-->' -%}
              {%- assign slide_count = clean_slides_arr.size -%}

              {% if slide_count > 0 %}
                {% assign list_items = clean_slides_captured | replace: '<!--@clean_split-->', '<!--@list/split-->' %}
                {% render 'resource-list',
                  list_items: list_items,
                  list_items_array: clean_slides_arr,
                  settings: section.settings,
                  carousel_ref: block.id,
                  slide_count: slide_count,
                  content_type: 'collections'
                %}
              {% else %}
                <p class="collection-tabs__empty-msg">No collections added to this tab. Please customize in the theme editor.</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-tabs {
    position: relative;
    overflow: hidden;
  }

  .collection-tabs__header {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 32px;
    padding-inline: var(--padding-md);
  }

  .collection-tabs__tab-btn {
    flex: 1 1 auto;
    min-width: 150px;
    max-width: 300px;
    padding: 12px 24px;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 100px;
    border: 1.5px solid #641B16;
    background-color: transparent;
    color: #641B16;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .collection-tabs__tab-btn.active {
    background-color: #641B16;
    color: #ffffff;
  }

  .collection-tabs__tab-btn:hover:not(.active) {
    background-color: rgb(100 27 22 / 5%);
  }

  .collection-tabs__body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media screen and (min-width: 750px) {
    .collection-tabs__body {
      display: grid;
      grid-template-columns: 240px 1fr;
      align-items: center;
      gap: 32px;
    }
  }

  .collection-tabs__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: var(--padding-md);
  }

  @media screen and (min-width: 750px) {
    .collection-tabs__left {
      align-items: flex-start;
      text-align: left;
    }
  }

  .collection-tabs__title {
    display: none;
    font-family: var(--font-subheading--family), Georgia, serif;
    font-style: italic;
    font-weight: 300;
    font-size: 2.25rem;
    line-height: 1.2;
    color: #641B16;
    margin: 0 0 12px 0;
  }

  .collection-tabs__title.active {
    display: block;
  }

  .collection-tabs__arrow {
    color: #641B16;
    margin-top: 8px;
    transform: rotate(0deg);
  }

  @media screen and (max-width: 749px) {
    .collection-tabs__arrow {
      transform: rotate(90deg);
      margin-top: 0;
      margin-bottom: 8px;
    }
  }

  .collection-tabs__right {
    min-width: 0;
    position: relative;
  }

  .collection-tabs__content {
    display: none;
  }

  .collection-tabs__content.active {
    display: block;
  }

  /* Collection card customizations */
  .collection-tabs__card {
    position: relative;
    width: 100%;
    text-align: center;
  }

  .collection-tabs__card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .collection-tabs__card-image-wrapper {
    position: relative;
    width: 100%;
    border-radius: 24px;
    overflow: hidden;
    margin-bottom: 12px;
    aspect-ratio: 1 / 1;
    background-color: rgb(0 0 0 / 3%);
  }

  .collection-tabs__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .collection-tabs__card:hover .collection-tabs__card-image {
    transform: scale(1.05);
  }

  .collection-tabs__card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #641B16;
    margin: 0;
  }

  .collection-tabs__empty-msg {
    color: #641B16;
    font-style: italic;
    padding-inline: var(--padding-md);
  }
{% endstylesheet %}

<script>
  (function() {
    function initCollectionTabs(section) {
      const tabs = section.querySelectorAll('.collection-tabs__tab-btn');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const targetTab = tab.getAttribute('data-tab');
          
          tabs.forEach(btn => btn.classList.remove('active'));
          tab.classList.add('active');

          section.querySelectorAll('.collection-tabs__title').forEach(title => {
            title.classList.remove('active');
          });
          const activeTitle = section.querySelector(`.collection-tabs__title--${targetTab}`);
          if (activeTitle) activeTitle.classList.add('active');

          section.querySelectorAll('.collection-tabs__content').forEach(content => {
            content.classList.remove('active');
          });
          const activeContent = section.querySelector(`#${targetTab}-content`);
          if (activeContent) activeContent.classList.add('active');

          // Trigger slideshow scroller layout update
          window.dispatchEvent(new Event('resize'));
        });
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.collection-tabs').forEach(initCollectionTabs);
    });

    document.addEventListener('shopify:section:load', (event) => {
      const section = event.target.querySelector('.collection-tabs');
      if (section) {
        initCollectionTabs(section);
      }
    });
  })();
</script>

