{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="footer-features{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  id="FooterFeatures-{{ section.id }}"
>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% if section.settings.heading != blank %}
      {%- liquid
        assign heading_text = section.settings.heading
        if heading_text contains '[' and heading_text contains ']'
          assign parts = heading_text | split: '['
          assign first_part = parts[0]
          assign rest = parts[1] | split: ']'
          assign cursive_part = rest[0]
          assign last_part = rest[1]
          capture formatted_heading
            echo first_part
            echo '<span class="footer-features__heading-cursive" style="color: ' | append: section.settings.accent_color | append: ';">'
            echo cursive_part
            echo '</span>'
            echo last_part
          endcapture
        else
          assign formatted_heading = heading_text
        endif
      -%}
      <h2 class="footer-features__heading" style="color: {{ section.settings.accent_color }};">
        {{ formatted_heading }}
      </h2>
    {% endif %}

    <hr class="footer-features__divider" style="border-color: {{ section.settings.text_color | default: '#1C1B1B' }}; opacity: 0.15;">

    <div class="footer-features__grid">
      {% for block in section.blocks %}
        <div class="footer-features__item" {{ block.shopify_attributes }}>
          <div class="footer-features__icon-wrapper">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 200 | image_tag: class: 'footer-features__icon-img', loading: 'lazy' }}
            {% else %}
              {% case block.settings.icon_preset %}
                {% when 'needle' %}
                  <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="footer-features__icon-svg">
                    <path d="M75 15 L25 80" stroke="#105C42" stroke-width="3" stroke-linecap="round" />
                    <circle cx="71" cy="19" r="1.5" fill="#FAF8F6" />
                    <path d="M71 19 C85 10, 90 35, 75 35 C60 35, 55 15, 71 19 Z" stroke="#D06927" stroke-width="2" stroke-linecap="round" fill="none" />
                  </svg>
                {% when 'mannequin' %}
                  <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="footer-features__icon-svg">
                    <line x1="50" y1="65" x2="50" y2="90" stroke="#1C1B1B" stroke-width="4" stroke-linecap="round" />
                    <path d="M40 90 L60 90" stroke="#1C1B1B" stroke-width="4" stroke-linecap="round" />
                    <path d="M45 90 L50 82 L55 90" stroke="#1C1B1B" stroke-width="3" stroke-linecap="round" fill="none" />
                    <path d="M42 20 C42 12, 58 12, 58 20 C58 23, 55 25, 55 28 L53 58 C53 62, 47 62, 47 58 L45 28 C45 25, 42 23, 42 20 Z" fill="#1C1B1B" />
                    <path d="M41 26 C41 22, 59 22, 59 26 L55 58 C55 60, 45 60, 45 58 Z" fill="#1C1B1B" />
                    <circle cx="50" cy="12" r="3" fill="#1C1B1B" />
                  </svg>
                {% when 'fabrics' %}
                  <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="footer-features__icon-svg">
                    <rect x="25" y="30" width="40" height="40" rx="4" fill="#E86E63" opacity="0.8" transform="rotate(-10 45 50)" />
                    <rect x="40" y="35" width="40" height="40" rx="4" fill="#F4CB53" opacity="0.8" transform="rotate(15 60 55)" />
                    <path d="M35 25 C45 25, 40 45, 55 45" stroke="#1C1B1B" stroke-width="1.5" stroke-dasharray="3 3" fill="none" />
                    <path d="M50 40 L55 48" stroke="#1C1B1B" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                {% when 'dress' %}
                  <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="footer-features__icon-svg">
                    <path d="M35 15 C38 25, 33 35, 38 55 C39 65, 32 80, 30 90 L70 90 C68 80, 61 65, 62 55 C67 35, 62 25, 65 15 C58 18, 54 18, 50 22 C46 18, 42 18, 35 15 Z" fill="#D5C5E6" />
                    <path d="M38 50 L62 50" stroke="#FAF8F6" stroke-width="2" />
                  </svg>
              {% endcase %}
            {% endif %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="footer-features__title" style="color: {{ section.settings.accent_color }};">
              {{ block.settings.title }}
            </h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="footer-features__description" style="color: {{ section.settings.text_color }};">
              {{ block.settings.description }}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Great+Vibes&display=swap');

  .footer-features {
    width: 100%;
  }

  .footer-features__heading {
    text-align: center;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 38px;
    font-weight: 400;
    line-height: 1.25;
    margin: 0 auto 24px auto;
    max-width: 800px;
  }

  .footer-features__heading-cursive {
    font-family: 'Great Vibes', cursive;
    font-size: 2.75rem;
    display: inline-block;
    vertical-align: middle;
    margin-top: -6px;
    padding-inline: 6px;
  }

  .footer-features__divider {
    border: 0;
    border-top: 1px solid;
    margin: 24px 0 40px 0;
    opacity: 0.15;
  }

  .footer-features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .footer-features__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .footer-features__icon-wrapper {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .footer-features__icon-svg {
    width: 60px;
    height: 60px;
    display: block;
  }

  .footer-features__icon-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .footer-features__title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 12px 0;
  }

  .footer-features__description {
    font-size: 11px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.85;
  }

  @media screen and (max-width: 989px) {
    .footer-features__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }
    .footer-features__heading {
      font-size: 1.75rem;
    }
    .footer-features__heading-cursive {
      font-size: 2.25rem;
    }
  }

  @media screen and (max-width: 749px) {
    .footer-features__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer Features",
  "tag": "section",
  "class": "footer-features-section",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page Width"
        },
        {
          "value": "full-width",
          "label": "Full Width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF8F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1C1B1B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Heading Color",
      "default": "#D06927"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More than clothing - [a reflection] of how you choose to show up",
      "info": "Use brackets [like this] to style words in elegant script font."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top Spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image Icon"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Icon Preset (Fallback)",
          "options": [
            { "value": "needle", "label": "Needle & Thread" },
            { "value": "mannequin", "label": "Mannequin Stand" },
            { "value": "fabrics", "label": "Fabric Swatches" },
            { "value": "dress", "label": "Dress Silhouette" }
          ],
          "default": "needle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Block Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_preset": "needle",
            "title": "Craftsmanship",
            "description": "Built with intention, every detail is carefully considered and precisely finished."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_preset": "mannequin",
            "title": "Made to Order",
            "description": "Each piece is created only when you choose it — reducing waste, increasing meaning."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_preset": "fabrics",
            "title": "Fabrics",
            "description": "We work with thoughtfully selected fabrics that feel as good as they look."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_preset": "dress",
            "title": "Stylish Yet",
            "description": "Designed to stand out effortlessly, without ever trying too hard."
          }
        }
      ]
    }
  ]
}
{% endschema %}
